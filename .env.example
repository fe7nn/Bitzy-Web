# ==============================================================================
# Bitzy Monorepo Unified Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Used by both Web & Discord Bot)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Service Role Key (Recommended for bot write operations to bypass RLS if needed)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 2. Discord Bot Configuration (Used by bot/bot.js & bot/deploy-commands.js)
# ------------------------------------------------------------------------------
DISCORD_TOKEN="MTEwMTIzNDU2Nzg5MDEyMzQ1Ng..."
CLIENT_ID="1101234567890123456"
# Optional: Target Guild ID for instant Slash Command deployment during testing
# GUILD_ID="123456789012345678"

# ------------------------------------------------------------------------------
# 3. Server & Health Check
# ------------------------------------------------------------------------------
PORT=3000

# ------------------------------------------------------------------------------
# 4. Live Bot Heartbeat URL (Used by Web Dashboard / Navbar status monitor)
# ------------------------------------------------------------------------------
# In production on Vercel, set this to your live Render bot service URL:
DISCORD_BOT_URL="https://your-bot-service.onrender.com"
# (For local testing, defaults to http://127.0.0.1:3000)